# ProdAssist environment configuration
# Copy this file to .env for local Docker development.

POSTGRES_DB=prodassist
POSTGRES_USER=prodassist
POSTGRES_PASSWORD=prodassist_dev_password

DATABASE_URL=postgresql+psycopg://prodassist:prodassist_dev_password@db:5432/prodassist

BACKEND_PORT=8000
FRONTEND_PORT=5173

VITE_API_URL=http://localhost:8000
